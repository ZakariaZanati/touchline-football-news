# Copy to .env and adjust. Every value here is optional — the app runs with
# no configuration at all.

# --- Summarisation ---------------------------------------------------------
# Leave ANTHROPIC_API_KEY unset and the app uses its built-in extractive
# summariser: no API calls, no cost, works offline of any LLM.
# Set it and every summary is written by Claude instead — properly rewritten
# headlines and prose rather than stitched-together sentences.
# ANTHROPIC_API_KEY=sk-ant-...

# auto (default) | extractive | claude
# 'auto' uses Claude when a key is present, extractive otherwise.
# SUMMARIZER=auto

# ANTHROPIC_MODEL=claude-opus-5

# Articles per Claude request. Batching is what keeps this cheap — raising it
# lowers cost per story but makes each request slower.
# CLAUDE_BATCH_SIZE=8

# Characters of each article sent to Claude. News is inverted-pyramid, so the
# first couple of thousand characters carry essentially all the facts.
# CLAUDE_BODY_CHARS=2500

# --- Pipeline --------------------------------------------------------------
# PORT=8787
# REFRESH_MINUTES=15
# MAX_AGE_HOURS=30

# Stories per refresh. Lower is faster; higher gives cross-source clustering
# more overlap to find, so duplicate coverage merges more reliably.
# MAX_STORIES=90

# ARTICLE_CONCURRENCY=5
# FEED_CONCURRENCY=6

# Identify yourself honestly. Several publishers' bot protection serves an
# empty HTTP 202 to a spoofed browser UA but serves a declared reader fine.
# USER_AGENT=FootballNewsBot/0.1 (+https://example.com; summarises headlines)
